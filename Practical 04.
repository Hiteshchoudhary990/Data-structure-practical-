

#include <stdio.h>
#include <ctype.h>

#define MAX 100

char stack[MAX];
int top = -1;

void push(char ch)
{
    stack[++top] = ch;
}

char pop()
{
    return stack[top--];
}

int precedence(char ch)
{
    if (ch == '^')
        return 3;

    if (ch == '*' || ch == '/' || ch == '%')
        return 2;

    if (ch == '+' || ch == '-')
        return 1;

    return 0;
}

void infixToPostfix(char infix[])
{
    char postfix[MAX];
    int j = 0;
    top = -1;

    for (int i = 0; infix[i] != '\0'; i++)
    {
        char ch = infix[i];

        if (ch == ' ' || ch == '\n' || ch == '\t')
            continue;

        if (isalnum((unsigned char)ch))
        {
            postfix[j++] = ch;
        }
        else if (ch == '(')
        {
            push(ch);
        }
        else if (ch == ')')
        {
            while (top != -1 && stack[top] != '(')
                postfix[j++] = pop();

            if (top == -1)
            {
                printf("Invalid expression\n");
                return;
            }

            pop();
        }
        else if (precedence(ch) > 0)
        {
            while (top != -1 && stack[top] != '(' &&
                  (precedence(stack[top]) > precedence(ch) ||
                  (precedence(stack[top]) == precedence(ch)
                   && ch != '^')))
            {
                postfix[j++] = pop();
            }

            push(ch);
        }
        else
        {
            printf("Invalid character\n");
            return;
        }
    }

    while (top != -1)
    {
        if (stack[top] == '(')
        {
            printf("Invalid expression\n");
            return;
        }

        postfix[j++] = pop();
    }

    postfix[j] = '\0';

    printf("Postfix Expression: %s\n", postfix);
}

int main()
{
    char infix[MAX];

    printf("Enter infix expression: ");

    if (fgets(infix, MAX, stdin) == NULL)
        return 1;

    infixToPostfix(infix);

    return 0;
}
